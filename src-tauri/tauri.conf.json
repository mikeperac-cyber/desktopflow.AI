{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskFlow AI",
  "version": "1.0.0",
  "identifier": "com.deskflow.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "DeskFlow AI",
        "url": "index.html?view=overlay",
        "width": 680,
        "height": 250,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true
      },
      {
        "label": "settings",
        "title": "DeskFlow AI Settings",
        "url": "index.html?view=settings",
        "width": 940,
        "height": 720,
        "minWidth": 820,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "focus": true
      },
      {
        "label": "highlight",
        "title": "DeskFlow Target Highlight",
        "url": "index.html?view=highlight",
        "width": 1,
        "height": 1,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "A safe AI command layer for Windows workflows.",
    "longDescription": "DeskFlow AI is a keyboard-first Windows desktop workflow copilot built around local safety and deterministic execution.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
